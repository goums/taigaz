# --- Deploy (Base Sepolia) ---------------------------------------------------
# Deployer key. Pays gas to DEPLOY the contract (not sponsored). Use a throwaway
# funded with test ETH from https://portal.cdp.coinbase.com/products/faucet
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Optional admin/owner (defaults to the deployer address if unset)
# OWNER=0x...

# RPCs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Contract verification on Basescan (https://basescan.org/myapikey)
BASESCAN_API_KEY=YOUR_BASESCAN_KEY

# --- Metadata (served by Vercel from frontend/public) ------------------------
# Where the JSON files (0.json..15.json, golden.json) are hosted. No trailing slash.
BASE_URI=https://taigaz.vercel.app/metadata
# Where the PNG images are hosted (used by generate_metadata.py). No trailing slash.
IMAGE_BASE=https://taigaz.vercel.app/nft
