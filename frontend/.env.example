# Privy app id (Dashboard -> app -> Settings). Public, safe to ship in frontend.
VITE_PRIVY_APP_ID=your-privy-app-id

# Deployed WeddingCollection address on Base Sepolia
VITE_CONTRACT_ADDRESS=0xYourDeployedContract

# Chain: 84532 = Base Sepolia, 8453 = Base mainnet
VITE_CHAIN_ID=84532

# NOTE: the CDP Paymaster URL is NOT set here. You register it in the Privy
# Dashboard (Wallets -> Smart wallets -> Paymaster) so Privy sponsors gas
# automatically. Keeping it out of the frontend avoids leaking your gas tank.
